{
  "copia-coview": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 .agents/hooks/PreInvocation-copia-coview.py",
        "timeout": 5
      }
    ]
  },
  "copia-read-seen": {
    "PostToolUse": [
      {
        "matcher": "view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/PostToolUse-copia-read-seen.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "copia-share": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 .agents/hooks/PreInvocation-copia-share.py",
        "timeout": 10
      }
    ]
  },
  "copia-chevron-intercept": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 .agents/hooks/Stop-copia-chevron.py",
        "timeout": 15
      }
    ]
  }
}
